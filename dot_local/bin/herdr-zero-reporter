#!/usr/bin/env bash
# shellcheck shell=bash
#
# Zero → Herdr lifecycle reporter.
#
# Zero runs hooks (via `zero hooks add`) and streams a JSON event on stdin.
# This script maps those events to Herdr pane-agent lifecycle state and
# reports it through the local Herdr CLI so Herdr can classify the Zero agent
# in the pane. This is a *custom* integration — Zero is not a built-in Herdr
# agent kind — implemented with the pattern Herdr documents at
# https://herdr.dev/docs/integrations/ (custom integrations / pane report-agent).
#
# Registered events and their mapping:
#
#   sessionStart        → working  (agent has a task and is starting)
#   beforeTool          → working  (agent about to execute a tool)
#   afterTool           → working  (agent between tools / finalising)
#   specialistStart     → working  (subagent spawned = active)
#   specialistStop      → working  (subagent finished, still active)
#   sessionEnd          → release  (drop authority; Herdr re-detects)
#
# Zero exposes no user-prompt-awaiting or permission-block event, so `idle`
# and `blocked` are never reported here; `working` covers every active phase
# and `sessionEnd` returns authority to Herdr's screen-manifest detection.
#
# No-op unless we're inside a Herdr pane (HERDR_ENV=1). Guards the Herdr
# binary to keep this a safe no-op outside Herdr and in CI.

set -euo pipefail

# No-op outside a Herdr pane / when the Herdr binary is unavailable.
[ "${HERDR_ENV:-0}" = "1" ] || exit 0
[ -n "${HERDR_PANE_ID:-}" ] || exit 0
[ -n "${HERDR_BIN_PATH:-}" ] && [ -x "${HERDR_BIN_PATH}" ] || exit 0
[ -z "${CI:-}" ] || exit 0

SRC="custom:zero"
AGENT="zero"

# Strictly increasing sequence per source+pane so Herdr ignores out-of-order
# reports from this integration.
seqfile="${TMPDIR:-/tmp}/zero-herdr-seq-$(printf '%s' "$HERDR_PANE_ID" | cksum | awk '{print $1}').txt"
seq="$(cat "$seqfile" 2>/dev/null || echo 0)"
seq="$((seq + 1))"
printf '%s\n' "$seq" >"$seqfile"

report() {
    "$HERDR_BIN_PATH" pane report-agent "$HERDR_PANE_ID" \
        --source "$SRC" --agent "$AGENT" --seq "$seq" "$@"
}

release() {
    "$HERDR_BIN_PATH" pane release-agent "$HERDR_PANE_ID" \
        --source "$SRC" --agent "$AGENT" --seq "$seq"
}

payload="$(cat)"

# Extract the (flat) event field without requiring jq.
event="$(printf '%s' "$payload" | sed -n 's/.*"event"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"

case "$event" in
    sessionStart)
        sid="$(printf '%s' "$payload" | sed -n 's/.*"sessionId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
        args=(--state working)
        # A non-empty session id is useful for Herdr session restore.
        [ -n "$sid" ] && [ "$sid" != "0" ] && args+=(--agent-session-id "$sid")
        report "${args[@]}"
        ;;
    beforeTool | afterTool | specialistStart | specialistStop)
        report --state working
        ;;
    sessionEnd)
        release
        ;;
    *)
        exit 0
        ;;
esac
