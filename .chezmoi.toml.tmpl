{{ $mlb := promptBoolOnce . "mlb" "MLB role (work identity, tools, secrets)" -}}
{{ $personal := promptBoolOnce . "personal" "Personal role (personal identity, tools, secrets)" -}}

[data]
    mlb = {{ $mlb }}
    personal = {{ $personal }}

[diff]
    exclude = ["scripts"]
    pager = "delta --line-numbers"

[status]
    exclude = ["scripts"]
