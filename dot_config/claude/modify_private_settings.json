{{- /* chezmoi:modify-template */ -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
{{- $existing = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $enabledPlugins := dict
      "claude-hud@claude-hud" true
      "context7@claude-plugins-official" true
      "worktrunk@worktrunk" true -}}
{{- $extraKnownMarketplaces := dict
      "claude-hud" (dict "source" (dict "repo" "jarrodwatts/claude-hud" "source" "github"))
      "worktrunk" (dict "source" (dict "repo" "max-sixty/worktrunk" "source" "github"))
      "claude-plugins-official" (dict "source" (dict "repo" "anthropics/claude-plugins-official" "source" "github")) -}}
{{- $pluginConfigs := dict -}}
{{- if .mlb -}}
{{- $enabledPlugins = set $enabledPlugins "akuity@akuity" true -}}
{{- $extraKnownMarketplaces = set $extraKnownMarketplaces "akuity" (dict "source" (dict "repo" "akuity/agent-plugins" "source" "github")) -}}
{{- $pluginConfigs = set $pluginConfigs "akuity@akuity" (dict "options" (dict "endpoint" "https://akuity.cloud/mcp")) -}}
{{- end -}}
{{- $statusLineCommand := `bash -c 'cols=$(stty size </dev/tty 2>/dev/null | awk '"'"'{print $2}'"'"'); export COLUMNS=$(( ${cols:-120} > 4 ? ${cols:-120} - 4 : 1 )); plugin_dir=$(ls -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/plugins/cache/*/claude-hud/*/ 2>/dev/null | sed '"'"'s|//*$|/|'"'"' | awk -F/ '"'"'{ print $(NF-1) "\t" $(0) }'"'"' | grep -E '"'"'^[0-9]+\.[0-9]+\.[0-9]+[[:space:]]'"'"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec "/opt/homebrew/bin/bun" --env-file /dev/null "${plugin_dir}src/index.ts"'` -}}
{{- $desired := dict
      "agentPushNotifEnabled" true
      "disableBundledSkills" true
      "disableWorkflows" true
      "enabledPlugins" $enabledPlugins
      "extraKnownMarketplaces" $extraKnownMarketplaces
      "hooks" (dict "SessionStart" (list (dict
          "hooks" (list (dict
              "command" (printf "bash '%s/.config/claude/hooks/herdr-agent-state.sh' session" .chezmoi.homeDir)
              "timeout" 10
              "type" "command"))
          "matcher" "*")))
      "inputNeededNotifEnabled" true
      "permissions" (dict "defaultMode" "auto")
      "statusLine" (dict "command" $statusLineCommand "type" "command")
      "theme" "auto" -}}
{{- if $pluginConfigs -}}
{{- $desired = set $desired "pluginConfigs" $pluginConfigs -}}
{{- end -}}
{{- if hasKey $existing "autoMode" -}}
{{- $desired = set $desired "autoMode" (index $existing "autoMode") -}}
{{- end -}}
{{ $desired | toPrettyJson }}
