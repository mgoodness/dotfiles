[daemon]
enabled = true
# 7d to match mise's cache_duration for its `fnox get GH_TOKEN`/
# `GH_ENTERPRISE_TOKEN` calls — see dot_config/mise/config.toml.tmpl for why
# mise resolves these independently instead of relying on this daemon /
# fnox's own shell activation. This is a daemon idle-shutdown window, not an
# on-disk secret TTL: values live only in the running daemon's memory and are
# gone on reboot/logout regardless of this setting.
idle_timeout = "7d"

[providers]
onepass_personal = { type = "1password", account = "my.1password.com" }
{{ if .mlb -}}
onepass_mlb = { type = "1password", account = "mlb.1password.com" }
{{ end -}}

[secrets]
GH_TOKEN = { provider = "onepass_personal", value = "op://Private/GH CLI PAT/credential" }
{{ if .mlb -}}
CONTEXT7_API_KEY = { provider = "onepass_mlb", value = "op://Employee/Context7/api key" }
EXA_API_KEY = { provider = "onepass_mlb", value = "op://Employee/Exa API Key/credential" }
JIRA_API_TOKEN = { provider = "onepass_mlb", value = "op://Employee/Jira CLI Token/credential" }
SOFTWAREUPDATE_PASSWORD = { provider = "onepass_mlb", value = "op://Employee/Okta/password" }
TF_TOKEN_terraform_mlbinfra_net = { provider = "onepass_mlb", value = "op://Employee/TFE Token/credential" }
{{ else if .personal -}}
CONTEXT7_API_KEY = { provider = "onepass_personal", value = "op://Private/Context7 API Key/credential" }
DEEPSEEK_API_KEY = { provider = "onepass_personal", value = "op://Private/DeepSeek API Key/credential" }
EXA_API_KEY = { provider = "onepass_personal", value = "op://Private/Exa API Key/credential" }
OPENCODE_API_KEY = { provider = "onepass_personal", value = "op://Private/OpenCode API Key/credential" }
OPENROUTER_API_KEY = { provider = "onepass_personal", value = "op://Private/OpenRouter API Key/credential" }
SOFTWAREUPDATE_PASSWORD = { provider = "onepass_personal", value = "op://Private/Mac mini/password" }
{{ end -}}
