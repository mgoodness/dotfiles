[daemon]
enabled = true
# Matches the 7-day cache_duration mise already uses when wrapping `fnox get
# GH_TOKEN`/`GH_ENTERPRISE_TOKEN` in exec() (dot_config/mise/config.toml.tmpl,
# Code/emu.github.com/mise.toml, Code/github.mlbam.net/mise.toml). Those calls
# barely touch this daemon since mise's own cache gates them to once per 7
# days regardless; this mainly extends the same window to the secrets fnox
# resolves directly via shell-hook (EXA_API_KEY, JIRA_API_TOKEN, etc.), which
# had no mise-side cache and were re-touching 1Password every 8h of idle time.
# It's a daemon idle-shutdown window, not an on-disk secret TTL: values live
# only in the running daemon's memory and are gone on reboot/logout regardless
# of this setting.
idle_timeout = "7d"

[providers]
onepass_personal = { type = "1password", account = "my.1password.com" }
{{ if .mlb -}}
onepass_mlb = { type = "1password", account = "mlb.1password.com" }
{{ end -}}

[secrets]
GH_TOKEN = { provider = "onepass_personal", value = "op://Private/GH CLI PAT/credential" }
{{ if .personal -}}
EXA_API_KEY = { provider = "onepass_personal", value = "op://Private/Exa API Key/credential" }
{{ end -}}
{{ if .mlb -}}
JIRA_API_TOKEN = { provider = "onepass_mlb", value = "op://Employee/Jira CLI Token/credential" }
TF_TOKEN_terraform_mlbinfra_net = { provider = "onepass_mlb", value = "op://Employee/TFE Token/credential" }
{{ end -}}
{{/* Admin password for unattended `softwareupdate --stdinpass` in up.fish's
     __up_macos. Same one-secret-name/role-picks-the-value pattern as
     CONTEXT7_API_KEY below -- only one of these is ever defined per machine. */ -}}
{{ if .personal -}}
SOFTWAREUPDATE_PASSWORD = { provider = "onepass_personal", value = "op://Private/Mac mini/password" }
{{ else if .mlb -}}
SOFTWAREUPDATE_PASSWORD = { provider = "onepass_mlb", value = "op://Employee/Okta/password" }
{{ end -}}
{{/* CONTEXT7_API_KEY exists in both 1Password accounts. TOML can't hold the
     key twice, so pick one explicitly. This matches the current opah
     behavior on a dual-role machine, where the personal secrets file was
     merged last and its "set -gx" silently overwrote mlb's -- an accident
     of file order that this makes an explicit choice instead. */ -}}
{{ if .personal -}}
CONTEXT7_API_KEY = { provider = "onepass_personal", value = "op://Private/Context7 API Key/credential" }
{{ else if .mlb -}}
CONTEXT7_API_KEY = { provider = "onepass_mlb", value = "op://Employee/Context7/api key" }
{{ end -}}
