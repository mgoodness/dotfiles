[settings]
env_cache = true
env_cache_ttl = "1h"
hook_env.chpwd_only = true
# Keep mise from putting its global shims dir on PATH during activation. Shims
# are global while tool configs are per-project, so a shim left behind by a tool
# since removed from a mise.toml (or configured only in one host's project dir,
# e.g. terraform in emu.github.com) shadows the real binary everywhere and fails
# with "No version is set for shim" outside its project. Activation already
# exposes the active tool versions directly, so the shims are unnecessary.
activate_shims = false

[env]
{{ if .mlb -}}
CLOUDSDK_ACTIVE_CONFIG_NAME = "mlb"
{{ else if .personal -}}
CLOUDSDK_ACTIVE_CONFIG_NAME = "personal"
{{ end -}}
GH_HOST = "github.com"
# PATH is explicit (not just an absolute path to fnox) because some callers
# invoke mise under a sanitized environment (e.g. Homebrew's superenv during
# `brew bundle dump`), which strips /opt/homebrew/bin and breaks fnox's
# internal `op` CLI lookup.
GH_TOKEN = { value = "{{ `{{ exec(command='PATH=/opt/homebrew/bin:/opt/homebrew/sbin:$PATH /opt/homebrew/bin/fnox get GH_TOKEN', cache_duration='7d', cache_key='personal-gh-token') }}` }}" }

[settings.ruby]
compile = false

[tools]
