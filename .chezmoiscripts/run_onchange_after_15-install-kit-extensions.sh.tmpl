#!/usr/bin/env bash
# shellcheck shell=bash

if [ -n "${CI:-}" ]; then
    echo "Skipping due to \$CI"
    exit
fi

if ! command -v kit &>/dev/null; then
    echo "Skipping: kit not found"
    exit
fi

# Kit extensions config hash: {{ index . "kitExtensions" | toJson | sha256sum }}

# `kit install` (without -u) exits non-zero if the extension is already
# installed, so this script isn't naturally idempotent like its siblings —
# guard each entry against the manifest before installing. Updates to
# already-installed extensions are `up`'s job (see __up_kit in up.fish).
manifest="$HOME/.local/share/kit/git/packages.json"

{{ range index . "kitExtensions" -}}
if [ ! -f "$manifest" ] || ! grep -q '{{ .id }}' "$manifest"; then
    kit install {{ .id }} --all
fi
{{ end -}}
