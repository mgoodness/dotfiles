#!/usr/bin/env bash
# shellcheck shell=bash

if [ -n "${CI:-}" ]; then
    echo "Skipping due to \$CI"
    exit
fi

if ! command -v npx &>/dev/null; then
    echo "Skipping: npx not found"
    exit
fi

#
# Agent skills config hash: {{ .agentSkills | toJson | sha256sum }}

{{ range .agentSkills -}}
{{ $id := .id -}}
{{ $skillArgs := "" -}}
{{ if index . "skills" -}}
{{ range .skills }}{{ $skillArgs = printf "%s --skill %s" $skillArgs . }}{{ end -}}
{{ end -}}
{{ $agentArgs := "" -}}
{{ if index . "agents" -}}
{{ range .agents }}{{ $agentArgs = printf "%s --agent %s" $agentArgs . }}{{ end -}}
{{ end -}}
npx skills add {{ $id }} --global{{ $skillArgs }}{{ $agentArgs }} --yes
{{ end -}}
