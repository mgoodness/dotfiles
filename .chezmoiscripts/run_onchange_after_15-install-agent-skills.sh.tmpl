#!/usr/bin/env bash
# shellcheck shell=bash

if [ -n "${CI:-}" ]; then
    echo "Skipping due to \$CI"
    exit
fi

if ! command -v gh &>/dev/null; then
    echo "Skipping: gh not found"
    exit
fi

#
# Agent skills config hash: {{ .agentSkills | toJson | sha256sum }}

{{ range .agentSkills -}}
{{ $id := .id -}}
{{ $skills := list -}}
{{ if index . "skills" -}}
{{ $skills = .skills -}}
{{ end -}}
{{ $agents := list "claude-code" "universal" -}}
{{ if index . "agents" -}}
{{ $agents = .agents | uniq -}}
{{ end -}}
{{ range $agents -}}
{{ $agent := . -}}
{{ if $skills -}}
{{ range $skills -}}
gh skill install {{ $id }} {{ . }} --agent {{ $agent }} --scope user -f
{{ end -}}
{{ else -}}
gh skill install {{ $id }} --all --agent {{ $agent }} --scope user -f
{{ end -}}
{{ end -}}
{{ end -}}
