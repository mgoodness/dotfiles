#!/usr/bin/env bash
# shellcheck shell=bash

# Enable macOS Remote Login (OpenSSH), scoped to this machine only. Host-
# specific rather than role-specific (mlb/personal, see ADR-0005) since this
# is about one physical Mac, not something either role should carry.
# Self-healing: guards itself before acting, so repeated `chezmoi apply` runs
# are a no-op, matching run_after_17-herdr-setup.sh.tmpl's convention.

if [ -n "${CI:-}" ]; then
    echo "Skipping due to \$CI"
    exit
fi

# Hostname verified directly on the Mac mini (`chezmoi execute-template
# '{{ "{{" }} .chezmoi.hostname {{ "}}" }}'`) rather than assumed — re-verify
# if this machine is ever renamed in System Settings.
{{ if eq .chezmoi.hostname "Mikes-Mac-mini" -}}
if [ "$(sudo systemsetup -getremotelogin)" != "Remote Login: On" ]; then
    echo "Enabling Remote Login..."
    sudo systemsetup -setremotelogin on
fi

# setremotelogin silently no-ops (no error, no prompt) if the calling app
# lacks Full Disk Access — a TCC grant only a human can make in System
# Settings > Privacy & Security. Re-check rather than assume it worked, so a
# denied/no-op grant doesn't fall through into configuring sshd for a service
# that was never actually started.
if [ "$(sudo systemsetup -getremotelogin)" != "Remote Login: On" ]; then
    echo "Remote Login still off after enabling — this app likely needs Full Disk Access (System Settings > Privacy & Security > Full Disk Access). Skipping sshd config until it's on." >&2
    exit
fi

# A drop-in file rather than editing sshd_config or its Apple-managed
# sshd_config.d/100-macos.conf directly: sshd_config Includes
# sshd_config.d/*.conf (in lexicographic order, first-set-value-wins) before
# any of its own directives. The "00-" prefix sorts ahead of Apple's own
# "100-macos.conf" so this always wins even if a future macOS starts setting
# PasswordAuthentication there too.
SSHD_DROPIN=/etc/ssh/sshd_config.d/00-disable-password-auth.conf
if [ "$(cat "$SSHD_DROPIN" 2>/dev/null)" != "PasswordAuthentication no" ]; then
    echo "Disabling SSH password authentication..."
    echo "PasswordAuthentication no" | sudo tee "$SSHD_DROPIN" >/dev/null
    if sudo launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
        sudo launchctl kickstart -k system/com.openssh.sshd
    fi
fi
{{ end -}}
