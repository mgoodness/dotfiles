# chezmoi:modify-template
{{- /*
Merge wanted config into Pi's existing ~/.pi/agent/settings.json instead of
replacing it, so runtime state Pi writes itself survives `chezmoi apply`:
lastChangelogVersion, provider/model/thinking changes from Ctrl+S, and any
packages added with `pi install`.

- `theme` is chezmoi-managed and always wins. Evaluated against pi v1's
  `system` theme (colors derived live from the terminal's own ANSI
  palette) via a side-by-side `/theme-table` role-swatch comparison in two
  Macterm panes; kept the hand-maintained Catppuccin Frappe/Latte files for
  their per-role variety (26 distinct Catppuccin hues feeding syntax
  highlighting, thinking-level borders, etc., vs. `system`'s 16 ANSI
  colors stretched across the same roles) over `system`'s single
  source-of-truth appeal.
- `defaultProvider`/`defaultModel`/`defaultThinkingLevel` are profile seeds:
  they only fill in when absent, so a Ctrl+S change is never reverted.
- Packages declared in `.chezmoidata/pi-packages.toml` are unioned into
  `packages`. A companion run_onchange script actually installs them
  (`pi install`), since declaring a package here only makes pi load it if
  it's already fetched under `~/.pi/agent/npm/`.
- Every other key (e.g. lastChangelogVersion) is preserved untouched.
*/ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $seeds := dict "defaultThinkingLevel" "high" -}}
{{- if .mlb -}}
{{-   $_ := set $seeds "defaultProvider" "github-copilot" -}}
{{-   $_ := set $seeds "defaultModel" "claude-sonnet-5" -}}
{{- else -}}
{{-   $_ := set $seeds "defaultProvider" "opencode-go" -}}
{{-   $_ := set $seeds "defaultModel" "deepseek-v4.1-flash" -}}
{{- end -}}
{{- $current = merge $current $seeds -}}
{{- $_ := set $current "theme" "catppuccin-latte/catppuccin-frappe" -}}
{{- $packages := index $current "packages" | default list -}}
{{- range .piPackages -}}
{{-   if not (has .id $packages) -}}
{{-     $packages = append $packages .id -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $current "packages" $packages -}}
{{- toPrettyJson $current -}}
